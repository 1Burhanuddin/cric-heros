rules_version = '2';

// CricHeros Firestore security rules
//
// Collection names mirror data/lib/utils/constant/firestore_constant.dart.
//
// MIGRATION NOTE (temporary, remove once Stage 2/3 of the Postgres migration
// lands): auth, users, teams, and their stats now live entirely in the new
// FastAPI/Postgres backend - the app no longer signs into Firebase Auth at
// all, so `request.auth` is always null here. matches/innings/ball_scores/
// partnerships/match_events/tournaments/leaderboard are still on Firestore
// pending Stage 2, so their rules below are opened up (no auth check) rather
// than requiring a Firebase Auth session that no longer exists. This is safe
// short-term only because there is no real production data yet - re-tighten
// these (ideally via the Firebase custom-token bridge, or by finishing the
// Stage 2 migration) before real users are on the app.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- live scoring (open pending Stage 2 - see migration note above) ---
    match /matches/{matchId} {
      allow read, write: if true;

      match /match_settings/{settingId} {
        allow read, write: if true;
      }
    }

    match /innings/{inningId} {
      allow read, write: if true;
    }

    match /ball_scores/{ballId} {
      allow read, write: if true;
    }

    match /partnerships/{partnershipId} {
      allow read, write: if true;
    }

    match /match_events/{eventId} {
      allow read, write: if true;
    }

    match /tournaments/{tournamentId} {
      allow read, write: if true;

      match /{tournamentSub=**} {
        allow read, write: if true;
      }
    }

    match /leaderboard/{docId} {
      allow read, write: if true;
    }

    // ---- dead collections (migrated to Postgres, kept here defensively) ---
    // users, user_sessions, teams, user_stat, team_stat, and contact_support
    // are no longer read/written via Firestore by the app (see AuthService,
    // UserService, TeamService in data/lib) - default-denied below like
    // everything else not explicitly listed.

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
